# Dodol Agent — Konfigurasi
# Copy file ini ke .env lalu isi API key Anda

# Provider: groq | claude | openai | ollama
DODOL_PROVIDER=ollama

# Model per-provider (opsional — pakai default jika kosong)
# GROQ_MODEL=qwen/qwen3.6-27b
# ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=qwen2.5-coder:7b

# API Keys (isi sesuai provider yang dipilih)
# GROQ_API_KEY=gsk_xxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# OPENAI_API_KEY=sk-xxxxx

# Fallback provider (opsional)
# DODOL_FALLBACK=ollama

# Sandbox settings
# DODOL_SANDBOX_TIMEOUT=30
# DODOL_SANDBOX_STRICT=0
